# =============================================================================
# Feishu Cursor MCP — 统一配置文件
# =============================================================================
# 复制到用户目录后填写（安装脚本会自动创建）：
#   Windows: %USERPROFILE%\.feishu-mcp\config.env
#   macOS:   ~/.feishu-mcp/config.env
#
# 也可通过环境变量 FEISHU_MCP_CONFIG 指向任意路径。
# 切勿提交含真实凭证的文件到 Git。
# =============================================================================

# --- 飞书自建应用凭证（必填）---
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MCP 运行模式 ---
# tenant = 应用身份（推荐，适合团队自动化）
# user   = 用户 OAuth（个人文档场景）
FEISHU_AUTH_TYPE=tenant
FEISHU_ENABLED_MODULES=document
FEISHU_SCOPE_VALIDATION=false
FEISHU_USER_KEY=local-dev

# --- 创建文档后自动为本人加协作者（tenant 模式推荐）---
FEISHU_AUTO_GRANT_COLLABORATOR=true
# 三选一：OpenID 优先
FEISHU_COLLABORATOR_OPEN_ID=
FEISHU_COLLABORATOR_MOBILE=
FEISHU_COLLABORATOR_EMAIL=
# view | edit | full_access
FEISHU_COLLABORATOR_PERM=full_access

# --- Wiki 协作区默认值（Agent 创建/列举文档时使用）---
# 飞书「我的文档库」中父文档节点；子文档即目录树
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_ROOT_NODE_TOKEN=
FEISHU_WIKI_ROOT_TITLE=文档助手专用

# --- 可选：云盘模式默认文件夹（与 Wiki 二选一，通常留空）---
FEISHU_DEFAULT_FOLDER_TOKEN=
